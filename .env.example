# API Keys for RAG with Contextual Retrieval - Updated for OpenRouter & Hugging Face

# =============================================================================
# LLM PROVIDER (OpenRouter Configuration)
# =============================================================================

# OpenRouter API Key for LLM (Contextual Embeddings)
# Get your key at: https://openrouter.ai/keys
# Replaces direct Anthropic API - uses unified billing
# Cost: ~$0.30/M tokens (Claude Haiku via OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# =============================================================================
# RERANKER CONFIGURATION (Hugging Face)
# =============================================================================

# Hugging Face Token for Inference API (Optional)
# Get your token at: https://huggingface.co/settings/tokens
# Used for: ms-marco-MiniLM-L-12-v3 reranker
# Cost: Free tier available
HF_TOKEN=your_hf_token_optional

# =============================================================================
# EMBEDDING PROVIDER (Keep Current)
# =============================================================================

# Voyage AI API Key - KEEPING THIS (Works well)
# Get your key at: https://www.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here

# =============================================================================
# DEPRECATED (No longer needed with OpenRouter)
# =============================================================================

# ANTHROPIC_API_KEY - Not needed (using OpenRouter instead)
# COHERE_API_KEY - Not needed (using Hugging Face instead)

# =============================================================================
# CONFIGURATION OPTIONS
# =============================================================================

# Reranker Deployment: "local" or "hf_inference"
RERANK_DEPLOYMENT=hf_inference

# Reranker Model: ms-marco-MiniLM-L-12-v3
# Alternatives: cohere-ir-v2-base (110M), itainb/PhoRanker (0.1B)
RERANK_MODEL=ms-marco/MiniLM-L-12-v3

# LLM Model: openrouter/anthropic/claude-haiku-4.5
# Alternatives: openrouter/anthropic/claude-3.5-sonnet (faster), openrouter/openai/gpt-4o-mini (similar)
LLM_MODEL=openrouter/anthropic/claude-haiku-4.5

# =============================================================================
# COST OPTIMIZATION NOTES
# =============================================================================

# OpenRouter Benefits:
# - Unified billing across all providers
# - Automatic model routing for cost savings
# - Single API key to manage
# - Potential access to multiple LLMs

# Hugging Face Reranker Benefits:
# - ms-marco-MiniLM: Completely free via inference API
# - High performance on BEIR benchmarks
# - No local hardware needed with hf_inference
# - Easy API integration

# Total Expected Costs (per 1000 chunks):
# - OpenRouter LLM: ~$2.40
# - Voyage Embeddings: ~$0.50
# - HF Reranker: $0 (free tier)
# - TOTAL: ~$2.90 (vs ~$2.10 with Cohere)
